{
  "name": "nojan-workspace-template",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "setup:env": "node scripts/configure.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "db:generate": "prisma generate",
    "db:check": "node scripts/check-fresh-target.mjs check",
    "db:deploy": "node scripts/db-command.mjs deploy",
    "db:admin": "node scripts/db-command.mjs admin",
    "db:studio": "node scripts/db-command.mjs studio",
    "studio:init": "node studio/server.mjs init",
    "studio": "node studio/server.mjs start",
    "studio:dev": "node studio/server.mjs dev",
    "studio:password": "node studio/server.mjs password",
    "studio:test": "node --test studio/offline.test.mjs",
    "studio:manifest": "node studio/manifest.mjs",
    "test:offline": "node --test scripts/offline.test.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.1.3",
    "zod": "4.6.7",
    "@fontsource/vazirmatn": "^5.2.8",
    "dotenv": "^17.2.3",
    "@inquirer/input": "4.3.1",
    "@inquirer/password": "4.0.23"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "~5.9.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
